# Example environment variables for CaneIA-VoiceLive
# Copy this file to `.env` and fill your own keys/IDs. DO NOT commit your real `.env`.
# PowerShell: `copy example.env .env`

AZURE_VOICELIVE_API_KEY="YOUR_AZURE_VOICELIVE_API_KEY"
AZURE_VOICELIVE_ENDPOINT="https://<your-resource>.services.ai.azure.com/"
AZURE_VOICELIVE_AGENT_ID=""
AZURE_VOICELIVE_PROJECT_NAME="Astrobot"
AZURE_VOICELIVE_API_VERSION="2025-10-01"
AZURE_ENV_NAME="voice-lives-playground-XXXX"
AZURE_LOCATION="eastus2"
AZURE_SUBSCRIPTION_ID="YOUR_AZURE_SUBSCRIPTION_ID"
AZURE_EXISTING_AIPROJECT_ENDPOINT="https://<your-resource>.services.ai.azure.com/api/projects/astrobot"
AZURE_EXISTING_AIPROJECT_RESOURCE_ID="/subscriptions/YOUR_SUBSCRIPTION_ID/resourceGroups/rg-Astrobot/providers/Microsoft.CognitiveServices/accounts/astrobot-resource/projects/astrobot"
AZD_ALLOW_NON_EMPTY_FOLDER=true
AZURE_VOICELIVE_VOICE="es-MX-MarinaNeural"
# Short instructions: replace placeholders above with your credentials and endpoints.
# Keep `.env` private and never push it. Use GitHub Secrets / CI variables when possible.
